#!/usr/bin/env python
# -*- coding: utf-8 -*-
#
# Generated by NAMD Launcher (`inamd nac prepare`). Edit the campaign
# `nac:` block and re-run rather than hand-editing this file.
#
# CA-NAC driver -- see third_party/ca_nac/ (Chu & Prezhdo, JPCL 2021).

from CAnac import nac_calc

T_start = @T_START@
T_end   = @T_END@

# NAC calculation + standard input generation for HFNAMD / PYXAID.
# bmin/bmax are the actual VASP band indices and must match the NAMD window.
is_combine = True
iformat = "@IFORMAT@"
bmin    = @BMIN@
bmax    = @BMAX@
potim   = @POTIM@

# Time-overlap storage window (actual VASP band indices). Wider than
# [bmin, bmax] so WAVECARs can be deleted / state reordering can run.
bmin_stored = @BMIN_STORED@
bmax_stored = @BMAX_STORED@

nproc   = @NPROC@

is_gamma_version = @IS_GAMMA@   # vasp_gam -> True, vasp_std -> False
is_reorder = @IS_REORDER@       # state reordering (use with care)
is_alle    = @IS_ALLE@          # all-electron NAC (needs NormalCAR)
is_real    = @IS_REAL@          # rotate to real NAC (mandatory for HFNAMD/PYXAID)

ikpt  = @IKPT@
ispin = @ISPIN@

# Snapshot directory layout: 001/ 002/ ... (trailing slash required).
Dirs = ['./%0@DIGITS@d/' % (ii + 1) for ii in range(T_start - 1, T_end)]

# ------------------------------------------------------------------
# Defaults below rarely need changing.
icor = @ICOR@
omin = bmin_stored
omax = bmax_stored

skip_file_verification = False
skip_TDolap_calc = False
skip_NAC_calc = False
onthefly_verification = True

checking_dict = {
    'skip_file_verification': skip_file_verification,
    'skip_TDolap_calc': skip_TDolap_calc,
    'skip_NAC_calc': skip_NAC_calc,
    'onthefly_verification': onthefly_verification,
}

nac_calc(Dirs, checking_dict, nproc,
         is_gamma_version, is_reorder, is_alle, is_real, is_combine,
         iformat, bmin, bmax,
         bmin_stored, bmax_stored, omin, omax,
         ikpt, ispin, icor, potim)
